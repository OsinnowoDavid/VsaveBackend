<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Welcome to VSave</title>
        <style>
            /* ===== RESET & BASE ===== */
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: "Segoe UI", Arial, sans-serif;
                background-color: #f4f7f6;
                margin: 0;
                padding: 0;
                -webkit-font-smoothing: antialiased;
            }

            /* ===== MAIN CONTAINER ===== */
            .email-wrapper {
                max-width: 600px;
                margin: 0 auto;
                padding: 20px;
                background-color: #f4f7f6;
            }

            .email-container {
                background-color: #ffffff;
                border-radius: 16px;
                padding: 40px 35px;
                box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
                border: 1px solid #e8f0ee;
            }

            /* ===== HEADER ===== */
            .email-header {
                text-align: center;
                padding-bottom: 30px;
                border-bottom: 3px solid #10b981;
                margin-bottom: 30px;
            }

            .logo-container {
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 12px;
                margin-bottom: 6px;
            }

            .logo-icon {
                width: 44px;
                height: 44px;
                background: #10b981;
                border-radius: 12px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 24px;
                color: #ffffff;
                font-weight: 700;
            }

            .logo-text {
                font-size: 32px;
                font-weight: 800;
                color: #0d9488;
                letter-spacing: -0.5px;
            }

            .logo-text span {
                color: #10b981;
            }

            .tagline {
                color: #6b7280;
                font-size: 14px;
                font-weight: 400;
                margin-top: 4px;
                letter-spacing: 0.3px;
            }

            /* ===== DIVIDER ===== */
            .divider {
                width: 60px;
                height: 3px;
                background: #10b981;
                margin: 0 auto 6px;
                border-radius: 4px;
            }

            /* ===== CONTENT ===== */
            .email-content {
                color: #1f2937;
                font-size: 16px;
                line-height: 1.7;
            }

            .greeting {
                font-size: 22px;
                font-weight: 700;
                color: #0d9488;
                margin-bottom: 16px;
            }

            .greeting span {
                color: #10b981;
            }

            .email-content p {
                margin-bottom: 16px;
                color: #4b5563;
            }

            .highlight-box {
                background: #f0fdf4;
                border-left: 4px solid #10b981;
                padding: 20px 24px;
                border-radius: 8px;
                margin: 24px 0;
                background: linear-gradient(135deg, #f0fdf4 0%, #ffffff 100%);
            }

            .highlight-box p {
                margin-bottom: 4px;
                color: #374151;
            }

            /* ===== OTP CODE ===== */
            .otp-container {
                background: #ffffff;
                border: 2px dashed #10b981;
                border-radius: 12px;
                padding: 20px;
                margin: 20px 0 24px;
                text-align: center;
                background: #fafffe;
            }

            .otp-label {
                font-size: 14px;
                color: #6b7280;
                font-weight: 500;
                letter-spacing: 0.5px;
                text-transform: uppercase;
                margin-bottom: 8px;
            }

            .otp-code {
                font-size: 48px;
                font-weight: 800;
                color: #0d9488;
                letter-spacing: 12px;
                font-family: "Courier New", monospace;
                background: #f0fdf4;
                padding: 12px 20px;
                border-radius: 10px;
                display: inline-block;
            }

            .otp-expiry {
                font-size: 13px;
                color: #ef4444;
                font-weight: 500;
                margin-top: 10px;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 6px;
            }

            .otp-expiry .clock-icon {
                font-size: 16px;
            }

            /* ===== BUTTON ===== */
            .btn-container {
                text-align: center;
                margin: 28px 0 20px;
            }

            .btn {
                display: inline-block;
                background: #10b981;
                color: #ffffff;
                padding: 14px 40px;
                font-size: 16px;
                font-weight: 600;
                text-decoration: none;
                border-radius: 8px;
                transition: background 0.3s ease;
                box-shadow: 0 4px 14px rgba(16, 185, 129, 0.3);
            }

            .btn:hover {
                background: #059669;
            }

            /* ===== FOOTER ===== */
            .email-footer {
                margin-top: 32px;
                padding-top: 28px;
                border-top: 2px solid #e8f0ee;
                text-align: center;
            }

            .footer-text {
                font-size: 13px;
                color: #9ca3af;
                line-height: 1.8;
            }

            .footer-text strong {
                color: #10b981;
                font-weight: 600;
            }

            .social-links {
                margin: 16px 0 14px;
                display: flex;
                justify-content: center;
                gap: 16px;
                flex-wrap: wrap;
            }

            .social-link {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                color: #6b7280;
                font-size: 13px;
                text-decoration: none;
                transition: color 0.2s;
            }

            .social-link:hover {
                color: #10b981;
            }

            .footer-legal {
                font-size: 11px;
                color: #d1d5db;
                line-height: 1.6;
                margin-top: 8px;
            }

            .footer-legal a {
                color: #10b981;
                text-decoration: none;
            }

            .footer-legal a:hover {
                text-decoration: underline;
            }

            /* ===== RESPONSIVE ===== */
            @media only screen and (max-width: 600px) {
                .email-wrapper {
                    padding: 12px;
                }

                .email-container {
                    padding: 28px 20px;
                    border-radius: 12px;
                }

                .logo-text {
                    font-size: 26px;
                }

                .logo-icon {
                    width: 38px;
                    height: 38px;
                    font-size: 20px;
                }

                .greeting {
                    font-size: 20px;
                }

                .email-content {
                    font-size: 15px;
                }

                .otp-code {
                    font-size: 36px;
                    letter-spacing: 8px;
                    padding: 10px 16px;
                }

                .highlight-box {
                    padding: 16px 18px;
                }

                .btn {
                    padding: 12px 32px;
                    font-size: 15px;
                    width: 100%;
                    text-align: center;
                }

                .social-links {
                    flex-direction: column;
                    gap: 8px;
                    align-items: center;
                }
            }

            @media only screen and (max-width: 400px) {
                .email-container {
                    padding: 20px 14px;
                }

                .logo-text {
                    font-size: 22px;
                }

                .otp-code {
                    font-size: 28px;
                    letter-spacing: 6px;
                }

                .greeting {
                    font-size: 18px;
                }

                .email-content {
                    font-size: 14px;
                }
            }

            /* ===== DARK MODE SUPPORT (Optional) ===== */
            @media (prefers-color-scheme: dark) {
                body {
                    background-color: #1a1a2e;
                }
                .email-wrapper {
                    background-color: #1a1a2e;
                }
                .email-container {
                    background-color: #16213e;
                    border-color: #2a3a5c;
                }
                .email-content p {
                    color: #d1d5db;
                }
                .greeting {
                    color: #10b981;
                }
                .highlight-box {
                    background: #1a2a3e;
                    border-left-color: #10b981;
                }
                .highlight-box p {
                    color: #d1d5db;
                }
                .otp-container {
                    background: #1a2a3e;
                    border-color: #10b981;
                }
                .otp-code {
                    background: #1a3a2e;
                    color: #34d399;
                }
                .otp-label {
                    color: #9ca3af;
                }
                .tagline {
                    color: #9ca3af;
                }
                .footer-text {
                    color: #6b7280;
                }
                .footer-text strong {
                    color: #34d399;
                }
                .footer-legal {
                    color: #4b5563;
                }
                .btn {
                    background: #10b981;
                }
                .btn:hover {
                    background: #059669;
                }
            }
        </style>
    </head>
    <body>
        <!-- ============================================================ -->
        <!-- EMAIL WRAPPER -->
        <!-- ============================================================ -->
        <div class="email-wrapper">
            <div class="email-container">
                <!-- ===== HEADER ===== -->
                <div class="email-header">
                    <div class="logo-container">
                        <svg
                            width="45"
                            height="45"
                            viewBox="0 0 183 192"
                            fill="none"
                            xmlns="http://www.w3.org/2000/svg"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                        >
                            <rect
                                width="183"
                                height="192"
                                fill="url(#pattern0_840_4033)"
                            />
                            <defs>
                                <pattern
                                    id="pattern0_840_4033"
                                    patternContentUnits="objectBoundingBox"
                                    width="1"
                                    height="1"
                                >
                                    <use
                                        xlink:href="#image0_840_4033"
                                        transform="matrix(0.00457692 0 0 0.00436697 -0.615385 -0.527523)"
                                    />
                                </pattern>
                                <image
                                    id="image0_840_4033"
                                    width="500"
                                    height="500"
                                    preserveAspectRatio="none"
                                    xlink:href="data:image/png;base64,"
                                />
                            </defs>
                        </svg>
                        <div class="logo-text">V<span>Save</span></div>
                    </div>
                    <div class="divider"></div>
                    <p class="tagline">
                        Your trusted partner for smart saving &amp; easy loans
                    </p>
                </div>

                <!-- ===== CONTENT ===== -->
                <div class="email-content">
                    <!-- Greeting -->
                    <p class="greeting">
                        Hello {{name}}, welcome to <span>VSave</span>! 👋
                    </p>

                    <!-- Intro -->
                    <p>
                        We're thrilled to have you join our community. At
                        <strong>VSave</strong>, we're committed to helping you
                        achieve your financial goals through
                        <strong>smart saving</strong> and
                        <strong>easy loans</strong>.
                    </p>

                    <!-- Highlight Box -->
                    <div class="highlight-box">
                        <p
                            style="
                                font-weight: 600;
                                color: #0d9488;
                                font-size: 15px;
                            "
                        >
                            🚀 Get started in 3 simple steps:
                        </p>
                        <p style="margin-bottom: 2px">
                            1️⃣ Complete your profile
                        </p>
                        <p style="margin-bottom: 2px">
                            2️⃣ Set your savings goal
                        </p>
                        <p style="margin-bottom: 0">
                            3️⃣ Start saving &amp; grow your wealth
                        </p>
                    </div>

                    <!-- OTP Section -->
                    <p style="font-weight: 500">
                        To get started, please verify your email using the code
                        below:
                    </p>

                    <div class="otp-container">
                        <div class="otp-label">🔐 Verification Code</div>
                        <div class="otp-code">{{otpCode}}</div>
                        <div class="otp-expiry">
                            <span class="clock-icon">⏰</span>
                            This code will expire in <strong>5 minutes</strong>
                        </div>
                    </div>

                    <p style="font-size: 14px; color: #6b7280">
                        💡 <strong>Tip:</strong> Copy the code and paste it in
                        the verification screen to activate your account.
                    </p>

                    <!-- Call to Action -->
                    <div class="btn-container">
                        <a href="{{verifyUrl}}" class="btn"
                            >Verify Your Email</a
                        >
                    </div>

                    <p
                        style="
                            font-size: 14px;
                            color: #6b7280;
                            text-align: center;
                            margin-top: 12px;
                        "
                    >
                        Or visit:
                        <a
                            href="{{appUrl}}"
                            style="
                                color: #10b981;
                                text-decoration: none;
                                font-weight: 500;
                            "
                            >vsave.com/verify</a
                        >
                    </p>

                    <!-- Closing -->
                    <p
                        style="
                            margin-top: 28px;
                            font-weight: 500;
                            color: #0d9488;
                        "
                    >
                        We're excited to have you on board! 🎉
                    </p>

                    <p
                        style="
                            color: #6b7280;
                            font-style: italic;
                            margin-top: 6px;
                        "
                    >
                        — The VSave Team
                    </p>
                </div>

                <!-- ===== FOOTER ===== -->
                <div class="email-footer">
                    <div class="social-links">
                        <a href="#" class="social-link">🌐 Website</a>
                        <a href="#" class="social-link">📱 App</a>
                        <a href="#" class="social-link">🐦 Twitter</a>
                        <a href="#" class="social-link">📘 Facebook</a>
                        <a href="#" class="social-link">📸 Instagram</a>
                    </div>

                    <p class="footer-text">
                        <strong>VSave</strong> — Your trusted partner for smart
                        saving &amp; easy loans
                    </p>

                    <p
                        class="footer-text"
                        style="font-size: 12px; color: #9ca3af"
                    >
                        📧 Need help? Contact us at
                        <a
                            href="mailto:support@vsave.com"
                            style="color: #10b981; text-decoration: none"
                        >
                            support@vsave.com
                        </a>
                    </p>

                    <p class="footer-legal">
                        &copy; 2026 VSave. All rights reserved.<br />
                        This email was sent to <strong>{{email}}</strong>. If
                        you didn't sign up, please
                        <a
                            href="#"
                            style="color: #10b981; text-decoration: none"
                            >unsubscribe</a
                        >.
                    </p>
                </div>
            </div>
        </div>
    </body>
</html>
